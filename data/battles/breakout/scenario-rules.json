{
  "schemaVersion": 1,
  "id": "breakout-scenario",
  "contentVersion": 12,
  "requires": {
    "terrainTypes": "classic-terrain",
    "unitTypes": "classic-units",
    "map": "breakout",
    "combatRules": "classic-combat",
    "gameRules": "classic-game"
  },
  "regions": {
    "attacker-deployment": {
      "name": "进攻部署",
      "shortLabel": "攻部署",
      "kind": "deployment",
      "color": "#315f88",
      "borderColor": "#65a1dc",
      "cells": ["5,4", "5,5", "5,6", "6,4", "6,5", "6,6", "7,4", "7,5", "7,6"]
    },
    "defender-deployment": {
      "name": "防守部署",
      "shortLabel": "防部署",
      "kind": "deployment",
      "color": "#78505a",
      "borderColor": "#df7178",
      "cells": [
        "1,7", "1,8",
        "2,8", "3,0", "3,8", "3.5,9"
      ]
    },
    "attacker-goal": {
      "name": "进攻目标",
      "shortLabel": "攻目标",
      "kind": "victory",
      "color": "#7a6730",
      "borderColor": "#f2cb68",
      "cells": ["1,7", "1,8", "2,8", "3,0", "3,8", "3.5,9"]
    }
  },
  "deployment": {
    "areaBindings": {
      "attacker": "attacker-deployment",
      "defender": "defender-deployment"
    },
    "unitProfiles": {
      "infantry": {
        "allowedPlayers": ["attacker", "defender"],
        "deployLimit": { "attacker": 12, "defender": 5 }
      },
      "antiTank": {
        "allowedPlayers": ["attacker", "defender"],
        "deployLimit": { "attacker": 1, "defender": 0 }
      },
      "machineGun": {
        "allowedPlayers": ["attacker", "defender"],
        "deployLimit": { "attacker": 0, "defender": 2 }
      }
    }
  },
  "configDefaults": {
    "reinforcement": 12
  },
  "victory": {
    "attackerTargetRegion": "attacker-goal",
    "reason": "attacker_reached_breakout_goal",
    "roundLimit": {
      "round": 28,
      "winner": "defender",
      "reason": "attacker_failed_before_round_limit"
    },
    "messages": {
      "attacker_reached_breakout_goal": "进攻方战棋到达突围目标区域。",
      "attacker_failed_before_round_limit": "第28回合结束时进攻方仍未到达目标区域。"
    }
  }
}
