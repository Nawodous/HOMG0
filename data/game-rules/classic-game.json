{
  "schemaVersion": 1,
  "id": "classic-game",
  "contentVersion": 3,
  "requires": {
    "combatRules": "classic-combat"
  },
  "deployment": {
    "rows": { "attacker": 6, "defender": 1 },
    "unitProfiles": {
      "infantry": {
        "allowedPlayers": ["attacker", "defender"],
        "deployLimit": { "attacker": 5, "defender": 4 }
      },
      "antiTank": {
        "allowedPlayers": ["attacker", "defender"],
        "deployLimit": { "attacker": 1, "defender": 1 }
      },
      "machineGun": {
        "allowedPlayers": ["attacker", "defender"],
        "deployLimit": { "attacker": 1, "defender": 0 }
      }
    }
  },
  "configDefaults": { "reinforcement": 28, "allowDeployAfterAction": true },
  "simultaneous": {
    "enabled": true,
    "default": false,
    "planningTimeoutMs": 120000,
    "allowShootAndMove": true,
    "deployDuringPlanning": true,
    "newUnitsCanAct": false,
    "movementConflict": "random_each_step",
    "deploymentConflict": "random",
    "failedMove": "return_to_origin",
    "deadShootersResolve": true
  },
  "victory": {
    "attackerTargetRow": 1,
    "messages": {
      "attacker_reached_first_row": "进攻方战棋到达第一行。",
      "attacker_eliminated": "进攻方增援耗尽且场上已无存活战棋。",
      "surrender": "对手投降。",
      "disconnect": "对手断开连接。",
      "leave_room": "对手退出房间。"
    }
  },
  "turn": {
    "machineGunMaxMoveSteps": 2,
    "allowDeployAfterActionConfigurable": true
  }
}
